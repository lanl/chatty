# chatty configuration example
# Copy to chatty.toml and customize for your setup

# =============================================================================
# REQUIRED: API Endpoint
# =============================================================================

# Base URL for OpenAI-compatible API
base_url = "http://localhost:1234/v1"  # LM Studio default
# base_url = "https://api.openai.com/v1"  # OpenAI
# base_url = "http://localhost:11434/v1"  # Ollama

# API Key (use ONE of these methods):
# Option 1: Direct key (OK for personal laptop, not for shared systems)
api_key = "your-api-key-here"

# Option 2: Key file (recommended for HPC/shared systems)
# api_key_file = "~/.secrets/chatty-api-key"

# =============================================================================
# MODEL SETTINGS
# =============================================================================

# Model name (depends on your endpoint)
model = "gpt-4.1"

# Context window size:
#   "auto" = fetch from /models endpoint
#   128000 = explicit size in tokens (default)
context_window = 128000

# Temperature (0.0 = deterministic, 1.0+ = creative)
# temperature = 0.2

# =============================================================================
# BEHAVIOR
# =============================================================================

# Enable streaming responses (show tokens as they arrive)
stream = true

# System prompt (sets assistant behavior)
# When RAG is enabled (rag_provider != "none") and no custom system_prompt is set,
# chatty automatically uses a citation-focused prompt that instructs the LLM to:
# - Use ONLY the provided context chunks
# - Cite sources using [1], [2], etc. notation
# - Acknowledge when context is insufficient
#
# To override the RAG prompt, uncomment and customize:
# system_prompt = "You are a helpful assistant."
#
# RAG default prompt (used when rag_provider is set and system_prompt is not):
# "You are a precise scientific assistant. Answer questions using ONLY the
# provided context chunks—do not use prior knowledge. Each chunk is numbered
# [1], [2], etc. You MUST cite sources using these numbers in your response.
# When multiple chunks support a claim, cite all of them. If sources conflict,
# acknowledge the disagreement. If the context is insufficient to answer, say
# so briefly."

# =============================================================================
# TLS / NETWORK (for institutional endpoints)
# =============================================================================

# CA bundle for institutional endpoints
# ca_bundle = "/path/to/ca-bundle.pem"

# Disable TLS verification (only for controlled dev environments!)
# verify_tls = false

# HTTP proxy (if required by your network)
# http_proxy = "http://proxy.internal:8080"

# Hosts that bypass the proxy
# no_proxy = "localhost,127.0.0.1"

# =============================================================================
# TRANSCRIPT LOGGING
# =============================================================================

# Enable JSONL transcript logging (saves all conversations)
transcript_enabled = true

# Transcript location options:
#   "./transcripts"                     # repo-local (good for development)
#   "~/.config/chatty/transcripts"      # user config dir (default)
transcript_path = "./transcripts"

# =============================================================================
# SESSION HISTORY
# =============================================================================

# Session location options:
#   "./sessions"                        # repo-local (default)
#   "~/.config/chatty/sessions"         # user config dir
session_path = "./sessions"

# =============================================================================
# COPY FALLBACK (for headless HPC where clipboard is unavailable)
# =============================================================================

# Where to save copied content when clipboard is unavailable
copy_fallback_path = "./copies"

# =============================================================================
# MARKDOWN EXPORT
# =============================================================================

# Where to save exported Markdown files (Ctrl+E)
export_path = "./exports"

# =============================================================================
# RAG (Retrieval-Augmented Generation) — v0.4+
# =============================================================================

# RAG provider: "none" (default) or "litkit"
# When set to "litkit", chatty will use litkit for corpus-grounded responses.
# Requires: litkit package installed (`uv add litkit` or `uv sync --extra litkit`)
# rag_provider = "none"

# litkit workspace path
# If omitted, chatty will check the LITKIT_WORKSPACE environment variable.
# The workspace must contain pre-built FAISS indices and SQLite database.
# Build indices with: litkit --build-only --faiss-writer
# rag_workspace = "~/litkit/workspace"

# Retrieval parameters
# rag_top_papers: Number of papers to shortlist in stage 1 (range: 1-5000)
# rag_top_papers = 500

# rag_top_chunks: Number of chunks to retrieve for LLM context (range: 1-100)
# rag_top_chunks = 30

# Query rewriting for multi-turn conversations (v0.4.2+)
# When enabled, short follow-up questions like "What about side effects?" are
# automatically rewritten using the LLM to include conversation context, e.g.,
# "What are the side effects of HIV treatments?" This improves retrieval quality
# for multi-turn conversations where follow-up questions reference prior context.
# rag_rewrite_enabled = true

# Environment variables (alternative to config file):
#   CHATTY_RAG_PROVIDER   - "none" or "litkit"
#   CHATTY_RAG_WORKSPACE  - path to litkit workspace
#   LITKIT_WORKSPACE      - also accepted for workspace path
#   CHATTY_RAG_TOP_PAPERS - stage 1 paper count
#   CHATTY_RAG_TOP_CHUNKS - stage 2 chunk count
#   CHATTY_RAG_REWRITE_ENABLED - enable/disable query rewriting
