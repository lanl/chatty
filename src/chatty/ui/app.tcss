/* Chatty application styles
 *
 * Layout: Header at top, scrollable chat log, input at bottom, status bar, footer
 * 
 * Widget hierarchy:
 *   Screen (grid layout)
 *   ├── Header (built-in)
 *   ├── #chat-log (ChatLog - scrollable message container)
 *   ├── #input-container (Container with ChatInput)
 *   ├── #status-bar (StatusBar)
 *   └── Footer (built-in)
 */

Screen {
    layout: grid;
    grid-size: 1;
    grid-rows: 1fr auto auto;
}

#chat-log {
    height: 100%;
    padding: 1;
}

MessageWidget {
    margin-bottom: 1;
}

/* User messages: dimmed - your input is secondary focus */
.user-message {
    color: $text-muted;
}

/* Assistant messages: default bright - main content */
.assistant-message {
    color: $text;
}

/* System messages: cyan/blue - informational */
.system-message {
    color: $accent;
}

/* Error messages: red with subtle background - attention needed */
.error-message {
    color: $error;
    background: $error 10%;
    padding: 1;
}

/* Search highlighting - CSS-only approach since Rich markup
 * doesn't work inside RichMarkdown. We highlight the whole
 * message widget with a colored left border. */
.search-match {
    border-left: thick $warning;
    padding-left: 1;
}

/* Current match gets more prominent highlighting */
.current-match {
    border-left: thick $success;
    background: $success 10%;
    padding-left: 1;
}

/* Search bar - fixed below header, hidden by default */
#search-bar {
    height: 1;
    width: 100%;
    background: $surface;
    padding: 0 1;
    display: none;
    dock: top;
}

#search-bar.visible {
    display: block;
}

#search-bar Input {
    width: 1fr;
    height: 1;
    border: none;
    background: $surface;
}

#search-bar Input:focus {
    border: none;
}

#search-bar #match-counter {
    width: auto;
    min-width: 12;
    height: 1;
    text-align: right;
    color: $text-muted;
    padding: 0 1;
}

#search-bar #match-counter.no-matches {
    color: $error;
}

#input-container {
    height: auto;
    max-height: 10;
    padding: 1;
    border-top: solid $primary;
}

#status-bar {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
}

#input {
    width: 100%;
    height: auto;
    min-height: 3;
    max-height: 8;
}

#footer {
    height: 1;
    background: $surface;
    color: $text-muted;
    padding: 0 1;
    dock: bottom;
}
