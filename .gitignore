# Repo-local config (may contain API keys)
chatty.toml

# Task prompt (re-used for new sessions, not part of codebase)
prompt.md

# Developer planning docs (version plans, roadmap, code reviews)
dev/

# Test artifacts
snapshot_report.html

# Transcripts (local conversation logs)
# Supported locations (set transcript_path in chatty.toml):
#   transcript_path = "./transcripts"             # repo-local
#   transcript_path = "~/.config/chatty/transcripts"  # user config dir
#   transcript_path = "~/.local/share/chatty/transcripts"  # XDG data dir
transcripts/
*.jsonl

# Sessions (saved conversation history)
# Supported locations (set session_path in chatty.toml):
#   session_path = "./sessions"                   # repo-local (default)
#   session_path = "~/.config/chatty/sessions"    # user config dir
#   session_path = "~/.local/share/chatty/sessions"  # XDG data dir
sessions/

# Copies (clipboard fallback files)
# Supported locations (set copy_fallback_path in chatty.toml):
#   copy_fallback_path = "./copies"               # repo-local (default)
#   copy_fallback_path = "~/.config/chatty/copies"  # user config dir
copies/

# Exports (markdown exports)
# Supported locations (set export_path in chatty.toml):
#   export_path = "./exports"                     # repo-local (default)
#   export_path = "~/.config/chatty/exports"      # user config dir
exports/

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

